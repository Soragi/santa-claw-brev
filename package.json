{
  "name": "santa-claw",
  "version": "4.29.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "start": "bash deploy/start-workshop.sh",
    "test": "node --test tests/*.test.mjs",
    "check:gb10": "node deploy/check-gb10.mjs",
    "install:gb10": "bash install.sh",
    "install:plan": "bash install.sh --plan",
    "prepare:gb10": "bash deploy/setup-gb10.sh prepare",
    "onboard:gb10": "bash deploy/setup-gb10.sh onboard",
    "verify:gb10": "node deploy/check-gb10.mjs --stage runtime --smoke",
    "model:start": "bash deploy/start-gb10-model.sh",
    "service:install": "node deploy/install-user-service.mjs",
    "service:idle-check": "node deploy/reload-app.mjs",
    "service:reload": "node deploy/reload-app.mjs --restart",
    "browser:prepare": "node deploy/prepare-browser.mjs"
  },
  "dependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.11",
    "@babel/traverse": "7.29.10",
    "@mediapipe/tasks-vision": "0.10.32",
    "@nvidia/openshell-sdk": "file:vendor/nvidia-openshell-sdk-0.0.116.tgz",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "4.4.7",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "manifold-3d": "3.5.4",
    "playwright": "1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  },
  "description": "Local-first 3D agent workshop for NVIDIA DGX Spark GB10"
}
