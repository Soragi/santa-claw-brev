# Export these non-secret settings in your shell; .env is not auto-loaded.
# Primary production target: Linux ARM64 DGX Spark / GB10.
SANTA_SANDBOX=santa-claw-gb10
SANTA_LOCAL_MODEL=santa-qwen
SANTA_ALLOW_CLOUD_INFERENCE=0
PORT=4310
NEMOCLAW_VLLM_PORT=8000
NEMOCLAW_OLLAMA_PORT=11434
# Optional only for an authenticated remote reverse proxy:
# SANTA_PUBLIC_ORIGIN=https://your-authenticated-spark.example
# Optional SSH alias for secure credential forms / remote operations:
# SANTA_SSH_HOST=your-spark-ssh-alias

# Native manual approvals and external-network audit in the village.
SANTA_NETWORK_GUARD=1
SANTA_OPENSHELL_GATEWAY=nemoclaw
